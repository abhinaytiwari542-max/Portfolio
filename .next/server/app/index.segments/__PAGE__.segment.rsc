1a:["$","div",null,{"className":"[direction:ltr] flex flex-col justify-center","children":[["$","div",null,{"className":"font-mono text-[0.65rem] uppercase tracking-[0.14em] text-ink-500","children":"02 · TWO-SIDED MARKETPLACE"}],["$","h3",null,{"className":"mt-3 text-[1.45rem] font-normal leading-snug tracking-[-0.03em] text-ink-50","children":"Rapido: an AI Marketplace Optimizer for bike taxis"}],["$","p",null,{"className":"mt-3 max-w-[60ch] text-[0.92rem] leading-relaxed text-ink-400","dangerouslySetInnerHTML":{"__html":"India's last-mile gap sits between expensive cabs and unreliable autos. I analysed the two-sided liquidity problem and scoped the four AI levers (demand forecasting, ETA, cancellation prediction and supply positioning) that move the North Star without needing matching infrastructure to exist first."}}],["$","div",null,{"className":"mt-5 border-l border-accent/50 py-1 pl-4","children":[["$","div",null,{"className":"font-mono text-[0.6rem] uppercase tracking-[0.14em] text-accent","children":"North Star"}],["$","div",null,{"className":"mt-1 text-[0.85rem] text-ink-200","children":"Completed rides per active supply hour"}]]}],["$","div",null,{"className":"mt-5 flex flex-wrap gap-2","children":[["$","span","Demand forecasting",{"className":"rounded-full border border-ink-800 px-2.5 py-1 text-[0.7rem] text-ink-400","children":"Demand forecasting"}],["$","span","Marketplace liquidity",{"className":"rounded-full border border-ink-800 px-2.5 py-1 text-[0.7rem] text-ink-400","children":"Marketplace liquidity"}],["$","span","Unit economics",{"className":"rounded-full border border-ink-800 px-2.5 py-1 text-[0.7rem] text-ink-400","children":"Unit economics"}],["$","span","Regulatory risk",{"className":"rounded-full border border-ink-800 px-2.5 py-1 text-[0.7rem] text-ink-400","children":"Regulatory risk"}]]}],["$","span",null,{"className":"mt-6 inline-flex items-center gap-2 text-sm text-ink-50","children":["Read case study",["$","svg",null,{"xmlns":"http://w