c:["$","section",null,{"id":"about","className":"py-24 lg:py-32","children":["$","div",null,{"className":"mx-auto w-full max-w-7xl px-6 lg:px-10 ","children":[["$","div",null,{"className":"mb-14 max-w-3xl","children":[["$","h2",null,{"className":"text-[clamp(1.7rem,3.4vw,2.6rem)] font-normal leading-[1.1] tracking-[-0.04em] text-ink-50","children":["How I got ",["$","span",null,{"style":{"fontFamily":"var(--font-editorial)"},"className":"text-accent","children":"here."}]]}],"$undefined"]}],["$","div",null,{"className":"grid gap-12 lg:grid-cols-[1.25fr_1fr]","children":[["$","div",null,{"className":"grid gap-5","children":[["$","p","0",{"className":"max-w-[60ch] text-[1.15rem] leading-relaxed tracking-[-0.02em] text-ink-50","dangerouslySetInnerHTML":{"__html":"I got into product from the numbers side, building DCF models at Aditya Birla Capital, and found I cared much more about <em>why the business worked</em> than about the model."}}],["$","p","1",{"className":"max-w-[64ch] text-[0.93rem] leading-relaxed text-ink-400","dangerouslySetInnerHTML":{"__html":"Since then it's been 0→1 work with founders: at <strong>Renan</strong>, taking AI products from an idea to something users touched; at <strong>Build AI</strong>, standing up field operations across multiple states and learning that GTM is mostly logistics wearing a suit."}}],["$","p","2",{"className":"max-w-[64ch] text-[0.93rem] leading-relaxed text-ink-400","dangerouslySetInnerHTML":{"__html":"The finance background left me with a habit I haven't shaken: I want to see the unit economics before I get excited about a feature. It's why every case study here ends with a contribution-margin line rather than a hockey stick."}}],["$","p","3",{"className":"max-w-[64ch] text-[0.93rem] leading-relaxed text-ink-400","dangerouslySetInnerHTML":{"__html":"Alongside that I'm finishing a <strong>B.E. in Electronics &amp; Communication Engineering at UIET, Panjab University</strong>, and building things on the side that are too small to be startups and too real to be toys."}}],["$","p","4",{"className":"max-w-[64ch] text-[0.93rem] leading-relaxed text-ink-400","dangerouslySetInnerHTML":{"__html":"Away from work: I led leadership and training programmes for 100+ cadets in the <strong>NCC</strong>, and I founded <strong>Mind Sustain</strong>, an NGO running financial-literacy bootcamps for underserved students, budgeting, savings, and how compounding actually feels over ten years."}}]]}],["$","div",null,{"className":"grid content-start gap-8","children":[["$","div",null,{"className":"border-t border-ink-800 pt-5","children":[["$","div",null,{"className":"font-mono text-[0.63rem] uppercase tracking-[0.13em] text-ink-500","children":"Education"}],["$","div",null,{"className":"mt-3 text-[0.92rem] text-ink-50","children":"B.E., Electronics & Communication Engineering"}],["$","div",null,{"className":"mt-1 text-[0.82rem] text-ink-500","children":"UIET, Panjab University · Aug 2023 to May 2027"}]]}],["$","div",null,{"className":"border-t border-ink-800 pt-5","children":[["$","div",null,{"className":"font-mono text-[0.63rem] uppercase tracking-[0.13em] text-ink-500","children":"Certifications"}],["$","ul",null,{"className":"mt-3 grid gap-2.5 text-[0.88rem] text-ink-200","children":[["$","li",null,{"children":"McKinsey.org Forward Program"}],["$","li",null,{"children":"Finlatics Investment Banking Experience"}],["$","li",null,{"children":"Forage Virtual IB & M&A Simulation"}]]}]]}],["$","div",null,{"className":"border-t border-ink-800 pt-5","children":[["$","div",null,{"className":"font-mono text-[0.63rem] uppercase tracking-[0.13em] text-ink-500","children":"Leadership"}],["$","ul",null,{"className":"mt-3 grid gap-2.5 text-[0.88rem] text-ink-200","children":[["$","li",null,{"children":"National Cadet Corps, 100+ cadets"}],"$L27"]}]]}]]}]]}]]}]}]
