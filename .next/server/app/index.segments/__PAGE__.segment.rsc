a:["$","section",null,{"id":"how","className":"py-24 lg:py-32","children":["$","div",null,{"className":"mx-auto w-full max-w-7xl px-6 lg:px-10 ","children":[["$","div",null,{"className":"mb-14 max-w-3xl","children":[["$","h2",null,{"className":"text-[clamp(1.7rem,3.4vw,2.6rem)] font-normal leading-[1.1] tracking-[-0.04em] text-ink-50","children":["Opinions I keep ",["$","span",null,{"style":{"fontFamily":"var(--font-editorial)"},"className":"text-accent","children":"having to defend."}]]}],"$undefined"]}],["$","$L4",null,{"className":"grid gap-x-16 gap-y-10 md:grid-cols-2","children":[["$","$L5","Pick the technique, don't default to one",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Pick the technique, don't default to one"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"Churn is a calibrated ML problem. Budget allocation is optimisation. Support triage is an LLM job. Reaching for an LLM because it's the exciting one is how you get an unauditable model setting discount amounts."}]]}],["$","$L5","Incrementality, or it didn't happen",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Incrementality, or it didn't happen"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"A customer who'd have come back anyway is wasted spend. I design permanent holdout groups in from day one, because without one you'll attribute organic behaviour to your own intervention and believe it."}]]}],["$","$L5","Constrain the model architecturally",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Constrain the model architecturally"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"Telling an LLM \"don't hallucinate tracks\" is a prompt. Only letting it select from a candidate set the recommender produced is an architecture. I prefer the second: it holds when the prompt doesn't."}]]}],["$","$L5","Guardrail metrics are real metrics",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Guardrail metrics are real metrics"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"Optimise CTR alone and you ship clickbait. Optimise targeting alone and you ship notification fatigue. Every North Star in my case studies carries a guardrail that's allowed to veto it."}]]}],["$","$L5","Label the assumption as an assumption",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Label the assumption as an assumption"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"Every case study here separates public knowledge, my proposals, and illustrative numbers. Inventing a 34% retention lift is easy and worthless. Saying \"here's the experiment that would tell us\" is the actual job."}]]}],["$","$L5","Build it if that's the fastest way to know",{"className":"border-t border-ink-800 pt-6","children":[["$","h3",null,{"className":"text-[0.98rem] font-medium tracking-[-0.02em] text-ink-50","children":"Build it if that's the fastest way to know"}],["$","p",null,{"className":"mt-2.5 max-w-[52ch] text-[0.88rem] leading-relaxed text-ink-400","children":"I ship code: Spring Boot, FastAPI, Next.js, Playwright. Not to be an engineer, but because a working thing settles arguments that a document keeps having, and it teaches me what I'm really asking a team for."}]]}]]}]]}]}]
