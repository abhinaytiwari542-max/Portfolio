oney action passes a deterministic policy engine, an approval gate, and a full audit trail. <strong>The LLM can suggest; it can't spend.</strong> Built in 22 sequential phases, each live-tested before the next started."}}],["$","div",null,{"className":"mt-5 flex flex-wrap gap-1.5","children":[["$","span","Next.js",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"Next.js"}],["$","span","TypeScript",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"TypeScript"}],["$","span","Gemini",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"Gemini"}],["$","span","Prisma",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"Prisma"}],["$","span","Postgres",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"Postgres"}],["$","span","52 tests",{"className":"rounded-md border border-ink-800 px-2 py-0.5 font-mono text-[0.62rem] text-ink-500","children":"52 tests"}]]}],["$","div",null,{"className":"mt-6 flex flex-wrap items-center gap-x-5 gap-y-2","children":[["$","a",null,{"href":"https://vriddhi-beta.vercel.app","target":"_blank","rel":"noopener","className":"inline-flex items-center gap-2 text-sm text-ink-50 hover:text-accent","children":[["$","$L3",null,{}]," Live demo ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"fill":"currentColor","viewBox":"0 0 256 256","children":[false,"$undefined",["$","path",null,{"d":"M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z"}]]}]]}],["$","a",null,{"href":"https://github.com/abhinaytiwari542-max/vriddhi","target":"_blank","rel":"noopener","className":"inline-flex items-center gap-1.5 text-[0.82rem] text-ink-500 hover:text-ink-200","children":["$L1e"," GitHu