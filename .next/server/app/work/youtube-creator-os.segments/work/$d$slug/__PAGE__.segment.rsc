 creator operating system that helps them ideate, produce, distribute, understand and monetise."}}],["$","div",null,{"className":"mt-7 flex flex-wrap gap-2","children":[["$","span","RICE prioritisation",{"className":"rounded-full border border-ink-800 px-3 py-1 text-[0.7rem] text-ink-400","children":"RICE prioritisation"}],["$","span","Technique selection",{"className":"rounded-full border border-ink-800 px-3 py-1 text-[0.7rem] text-ink-400","children":"Technique selection"}],["$","span","Composite North Star",{"className":"rounded-full border border-ink-800 px-3 py-1 text-[0.7rem] text-ink-400","children":"Composite North Star"}],["$","span","Homogenisation risk",{"className":"rounded-full border border-ink-800 px-3 py-1 text-[0.7rem] text-ink-400","children":"Homogenisation risk"}],["$","span","Creator personas",{"className":"rounded-full border border-ink-800 px-3 py-1 text-[0.7rem] text-ink-400","children":"Creator personas"}]]}]]}],["$","dl",null,{"className":"grid content-start gap-5 self-end","children":[["$","div","Type",{"className":"border-t border-ink-800 pt-3","children":[["$","dt",null,{"className":"font-mono text-[0.6rem] uppercase tracking-[0.13em] text-ink-500","children":"Type"}],["$","dd",null,{"className":"mt-1.5 text-[0.88rem] text-ink-50","children":"Self-directed AI PM case study"}]]}],["$","div","Domain",{"className":"border-t border-ink-800 pt-3","children":[["$","dt",null,{"className":"font-mono text-[0.6rem] uppercase tracking-[0.13em] text-ink-500","children":"Domain"}],["$","dd",null,{"className":"mt-1.5 text-[0.88rem] text-ink-50","children":"Creator platform"}]]}],["$","div","Focus",{"className":"border-t border-ink-800 pt-3","children":[["$","dt",null,{"className":"font-mono text-[0.6rem] uppercase tracking-[0.13em] text-ink-500","children":"Focus"}],["$","dd",null,{"className":"mt-1.5 text-[0.88rem] text-ink-50","children":"Data-to-action gap"}]]}],["$","div","Reading time",{"className":"border-t border-ink-800 pt-3","children":["$L4"